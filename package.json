{
    "name": "chess-vision-trainer",
    "version": "2.0.0",
    "description": "Шахматный тренажёр для развития тактического зрения",
    "type": "module",
    "scripts": {
        "build": "tsc && tailwindcss -c tailwind.config.cjs -i src/input.css -o style.css --minify",
        "build:css": "tailwindcss -c tailwind.config.cjs -i src/input.css -o style.css --minify",
        "build:watch": "tsc --watch",
        "css:watch": "tailwindcss -c tailwind.config.cjs -i src/input.css -o style.css --watch",
        "serve": "python -m http.server 5500",
        "dev": "npm run build:watch"
    },
    "keywords": [
        "chess",
        "training",
        "tactics",
        "vision"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^26.1.2",
        "daisyui": "^5.7.8",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.3.0"
    }
}
